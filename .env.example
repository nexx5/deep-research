# ============================================================
# 调研管理平台 - 环境配置模板 (.env.example)
# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。
# ============================================================

# ---- zhishibao 知识包嵌入 API（OpenAI 兼容端点）----
# 用于断言的向量嵌入与语义检索。任意 OpenAI 兼容 embeddings 服务均可。
EMBED_BASE_URL=http://your-embed-host:port/v1
EMBED_API_KEY=sk-your-key-here
EMBED_MODEL=qwen3-embed

# ---- opencode 模型配置 ----
# opencode.json 中的 model 字段为占位符；实际使用前请按你的 provider 修改。
# 示例：OPENCODE_MODEL=your-provider/your-model
# OPENCODE_MODEL=

# ---- qmd 本地检索（可选）----
# 指定 embedding 模型文件（本地 GGUF）时使用，默认 hf:Qwen/Qwen3-Embedding-0.6B
# QMD_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf
# QMD_LLAMA_GPU=auto        # 可选：metal / cuda / vulkan / false
